<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Received Message -->
    <LinearLayout
        android:id="@+id/receivedMessageContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:layout_marginEnd="64dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/receivedMessageLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/received_message_background"
            android:padding="10dp">

            <TextView
                android:id="@+id/receivedMessageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp"
                tools:text="This is a received message" />

        </LinearLayout>

        <TextView
            android:id="@+id/receivedTimestampTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="4dp"
            android:textSize="11sp"
            android:textColor="@color/gray_500"
            tools:text="10:30 AM" />

    </LinearLayout>

    <!-- Sent Message -->
    <LinearLayout
        android:id="@+id/sentMessageContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="64dp"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:id="@+id/sentMessageLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sent_message_background"
            android:padding="10dp">

            <TextView
                android:id="@+id/sentMessageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp"
                tools:text="This is a sent message" />

        </LinearLayout>

        <TextView
            android:id="@+id/sentTimestampTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:textSize="11sp"
            android:textColor="@color/gray_500"
            tools:text="10:31 AM" />

    </LinearLayout>

</LinearLayout>
